[Unit]
Description=GoodPrice - scrape Mega Image -> Postgres
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/goodprice
Environment=PYTHONPATH=/opt/goodprice
ExecStart=/opt/goodprice/.venv/bin/python /opt/goodprice/scrapers/megaimage.py
