[Unit]
Description=GoodPrice - scrape Sezamo -> Postgres
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/goodprice
Environment=PYTHONPATH=/opt/goodprice
ExecStart=/opt/goodprice/.venv/bin/python /opt/goodprice/scrapers/sezamo.py
# log in journal: journalctl -u goodprice-sezamo
