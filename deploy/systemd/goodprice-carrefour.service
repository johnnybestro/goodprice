[Unit]
Description=GoodPrice - scrape Carrefour -> Postgres
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/goodprice
Environment=PYTHONPATH=/opt/goodprice
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/goodprice/.venv/bin/python /opt/goodprice/scrapers/carrefour.py
