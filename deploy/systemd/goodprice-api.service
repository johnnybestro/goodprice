[Unit]
Description=GoodPrice API (FastAPI/uvicorn)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/goodprice
Environment=PYTHONPATH=/opt/goodprice
ExecStart=/opt/goodprice/.venv/bin/uvicorn goodprice.api:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
