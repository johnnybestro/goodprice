# GoodPrice — configurare. Copiaza in `.env` si completeaza.
# .env e gitignored; .env.example e sablonul versionat.

# --- Acces container (LXC Proxmox) ---
GOODPRICE_SSH_ALIAS=goodprice          # alias din ~/.ssh/config -> `ssh goodprice`
GOODPRICE_HOST=192.168.1.112

# --- PostgreSQL ---
GOODPRICE_DB_USER=goodprice
GOODPRICE_DB_PASS=goodprice_dev        # SCHIMBA in productie
GOODPRICE_DB_NAME=goodprice
GOODPRICE_DB_HOST=localhost
GOODPRICE_DB_PORT=5432
# URL-ul complet (folosit de cod). Daca e setat, are prioritate.
GOODPRICE_DATABASE_URL=postgresql://goodprice:goodprice_dev@localhost:5432/goodprice

# --- Redis ---
GOODPRICE_REDIS_URL=redis://localhost:6379/0
